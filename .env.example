# Optional local settings only. This file contains no credentials.
# CLI root can also be set explicitly with workai --root /path/to/workspace.
# WORKAI_TECTONIC points to a verified local binary when it is not on PATH.
WORKAI_TECTONIC=
# Browser session paths belong in ignored config/platforms.yaml.
# Optional runtime AI source review and ID-only CV ranking. Choose a model your
# account can access. No model is selected or billed until both values are set.
OPENAI_API_KEY=
WORKAI_OPENAI_MODEL=
OPENAI_PROJECT_ID=
